# ───────────── Servidor ─────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Dominio base. Cada negocio vive en <subdominio>.BASE_DOMAIN
# Local:        BASE_DOMAIN=localhost      -> http://demo.localhost:3000
# Producción:   BASE_DOMAIN=midominio.com  -> https://labcentral.midominio.com
BASE_DOMAIN=localhost

# Obligatorio en producción: cadena larga y aleatoria (mínimo 32 caracteres).
# Se puede generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# true si hay un proxy (Caddy, nginx, Cloudflare...) delante de la aplicación.
TRUST_PROXY=false
# En producción con HTTPS: true
COOKIE_SECURE=false

# ───────────── Base de datos ─────────────
# Local (SQLite, sin instalar nada):
DATABASE_FILE=./data/app.db
# Producción (PostgreSQL externo). Si se define, se usa en lugar de SQLite:
# DATABASE_URL=postgres://usuario:clave@host:5432/basedatos

# ───────────── Tasa BCV ─────────────
# Fuente pública de la tasa oficial. Debe devolver JSON con el valor
# en uno de estos campos: promedio, price, precio, usd, rate, valor.
BCV_API_URL=https://ve.dolarapi.com/v1/dolares/oficial
# Horas sin verificar antes de mostrar el aviso de "tasa desactualizada"
BCV_STALE_HOURS=36
# true para desactivar la consulta automática (se usaría solo la tasa manual)
BCV_DISABLED=false
# Para hostings sin proceso permanente: llamar POST /api/cron/tasa con la
# cabecera "x-cron-secret: <este valor>" desde un cron externo.
CRON_SECRET=

# Huso horario de las estadísticas (minutos respecto a UTC). Venezuela: -240
TZ_OFFSET_MIN=-240

# ───────────── Superadministrador (se crea con npm run seed) ─────────────
SUPER_EMAIL=
SUPER_PASSWORD=

{
  // Cloudflare Workers + D1. Documentación: https://developers.cloudflare.com/workers/wrangler/configuration/
  "name": "lab", // da la dirección lab.<subdominio-de-la-cuenta>.workers.dev
  "main": "src/server.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"], // Buffer y node:crypto (firma HMAC de las sesiones)

  // Páginas e imágenes. run_worker_first: el Worker decide el negocio por la ruta (/<negocio>) ANTES de servir cualquier página.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // Base de datos. Crea la base con:  npx wrangler d1 create presupuesto
  // y pega aquí el database_id que te devuelve.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "presupuesto",
      "database_id": "07ad667d-dfb1-4220-b604-cafc358d51ba",
      "migrations_dir": "migrations"
    }
  ],

  // Variables públicas. Los secretos (SESSION_SECRET, CRON_SECRET, SUPER_*) NO van aquí: `wrangler secret put NOMBRE`.
  "vars": {
    // "BASE_DOMAIN": "localhost",     // en producción: "tudominio.com"
    // "ENVIRONMENT": "development",   // en producción: "production" (cookies Secure, sin ?negocio=)
    "BASE_DOMAIN": "lab.dualstudio.app",
    "ENVIRONMENT": "production",
    "TZ_OFFSET_MIN": "-240",
    "BCV_API_URL": "https://ve.dolarapi.com/v1/dolares/oficial",
    "BCV_STALE_HOURS": "36",
    "BCV_DISABLED": "false"
  },

  // Tasa BCV: una consulta por hora.
  "triggers": { "crons": ["0 * * * *"] },

  // Dominio propio: lab.dualstudio.app/<negocio>. La zona dualstudio.app está en Cloudflare;
  // con custom_domain, Cloudflare crea el registro DNS y el certificado al desplegar.
  // Cada negocio vive en una ruta (/<negocio>), así que no hace falta DNS comodín.
  // La dirección lab.<cuenta>.workers.dev sigue activa; para apagarla: "workers_dev": false
  "routes": [{ "pattern": "lab.dualstudio.app", "custom_domain": true }]
}

{
  "name": "dualstudio-apps",
  "private": true,
  "description": "Dual Studio Apps: monorepo con las apps de dualstudio.app y sus librerías compartidas.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "dev:cotizalo": "npm run dev -w cotizalo",
    "dev:central": "npm run dev -w central",
    "deploy:cotizalo": "npm run deploy -w cotizalo",
    "deploy:central": "npm run deploy -w central"
  }
}

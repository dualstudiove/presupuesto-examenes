{
  "name": "presupuesto-examenes",
  "version": "1.0.0",
  "description": "Presupuestos de exámenes para laboratorios clínicos (multinegocio, marca blanca, precios en REF y tasa BCV).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning src/seed.js --demo",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  }
}

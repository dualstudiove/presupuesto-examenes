{
  "name": "cotizalo",
  "version": "2.0.0",
  "description": "Cotízalo: presupuestos de exámenes para laboratorios clínicos (multinegocio) sobre Cloudflare Workers + Hono + D1.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "construir": "node ../../herramientas/construir.js .",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrar:local": "wrangler d1 migrations apply presupuesto --local",
    "db:migrar": "wrangler d1 migrations apply presupuesto --remote",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning src/seed.js --demo",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": { "hono": "^4.6.0" },
  "devDependencies": { "wrangler": "^4.0.0" }
}

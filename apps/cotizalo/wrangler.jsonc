{
  // Cloudflare Workers + D1. Documentación: https://developers.cloudflare.com/workers/wrangler/configuration/
  "name": "cotizalo",
  "main": "src/server.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"], // Buffer y node:crypto (firma HMAC de las sesiones)

  // Antes de `wrangler dev` y `wrangler deploy` (también en Cloudflare) se arma .publicar/ con public/, el sistema
  // de diseño y las utilidades compartidas, todo bajo BASE_PATH (ver herramientas/construir.js).
  "build": {
    "command": "npm run construir",
    "watch_dir": ["public", "../../packages/diseno", "../../packages/comun/web"]
  },

  // Páginas e imágenes.
  // run_worker_first: las páginas pasan por el Worker (decide el negocio por la ruta <base>/<negocio>); los archivos
  // fijos (CSS, JS, imágenes, librerías compartidas) los sirve Cloudflare directamente: no gastan peticiones del
  // plan gratuito. Las rutas llevan BASE_PATH delante: si cambias BASE_PATH, cámbialas también.
  "assets": {
    "directory": "./.publicar",
    "binding": "ASSETS",
    "run_worker_first": [
      "/cotizalo",
      "/cotizalo/*",
      "!/cotizalo/css/*",
      "!/cotizalo/js/*",
      "!/cotizalo/img/*",
      "!/cotizalo/_ds/*"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // Base de datos. Crea la base con:  npx wrangler d1 create presupuesto
  // y pega aquí el database_id que te devuelve.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "presupuesto",
      "database_id": "07ad667d-dfb1-4220-b604-cafc358d51ba",
      "migrations_dir": "migrations"
    }
  ],

  // Variables públicas. Los secretos (SESSION_SECRET, CRON_SECRET, SUPER_*) NO van aquí: `wrangler secret put NOMBRE`.
  "vars": {
    // BASE_PATH: ruta donde vive la app dentro del dominio. Hoy: dualstudio.app/cotizalo.
    // Si la app se muda a su propio dominio (p. ej. cotizalo.com), pon "" y cambia "routes" abajo:
    // las direcciones pasan a cotizalo.com/<negocio> sin tocar el código.
    "BASE_PATH": "/cotizalo",
    // "ENVIRONMENT": "development",   // en producción: "production" (cookies Secure)
    "ENVIRONMENT": "production",
    "TZ_OFFSET_MIN": "-240",
    "BCV_API_URL": "https://ve.dolarapi.com/v1/dolares/oficial",
    "BCV_STALE_HOURS": "36",
    "BCV_DISABLED": "false"
  },

  // Tasa BCV: una consulta por hora.
  "triggers": { "crons": ["0 * * * *"] },

  // dualstudio.app/cotizalo y todo lo que cuelga de ahí (cada negocio en dualstudio.app/cotizalo/<negocio>).
  // El resto de dualstudio.app lo atiende la página central (central/wrangler.jsonc).
  // Deben coincidir con BASE_PATH. Con dominio propio, p. ej.:
  //   "routes": [{ "pattern": "cotizalo.com", "custom_domain": true }]   y   "BASE_PATH": ""
  "routes": [
    { "pattern": "dualstudio.app/cotizalo", "zone_name": "dualstudio.app" },
    { "pattern": "dualstudio.app/cotizalo/*", "zone_name": "dualstudio.app" }
  ],
  // Sin dirección *.workers.dev: la única dirección es la del dominio. (Con "routes", Cloudflare la apaga
  // igualmente; aquí queda explícito. Ponla en true si algún día la necesitas para pruebas.)
  "workers_dev": false,
  "preview_urls": true,

  // ── Sitio de pruebas (Cloudflare «Previews») ──
  // Cada cambio en una rama que no es master (p. ej. desarrollo) se publica como versión de prueba,
  // con su propia dirección *-cotizalo.<cuenta>.workers.dev, sin tocar dualstudio.app.
  // Usa una base de datos APARTE (presupuesto-pruebas): las pruebas nunca tocan los datos reales.
  // La app crea sola las tablas en esa base vacía. Las claves NO van aquí: son secretos de las vistas
  // previas en Cloudflare (SESSION_SECRET, SUPER_EMAIL, SUPER_PASSWORD); ver README.
  "previews": {
    "vars": {
      "BASE_PATH": "/cotizalo",
      "ENVIRONMENT": "production",
      "TZ_OFFSET_MIN": "-240",
      "BCV_API_URL": "https://ve.dolarapi.com/v1/dolares/oficial",
      "BCV_STALE_HOURS": "36",
      "BCV_DISABLED": "false",
      // Botón «Crear negocio de ejemplo» en el panel del superadministrador (solo aquí, nunca en producción)
      "DATOS_DE_EJEMPLO": "true"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "presupuesto-pruebas",
        "database_id": "12a3b294-0f88-4505-9a0d-f9dda1aade9c",
        "migrations_dir": "migrations"
      }
    ]
  }
}

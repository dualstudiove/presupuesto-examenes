{
  // Planifica en Cloudflare Workers (+ D1). Generado con `npm run nueva-app`.
  // Documentación: https://developers.cloudflare.com/workers/wrangler/configuration/
  "name": "planifica",
  "main": "src/server.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"], // Buffer y node:crypto (firma de las sesiones)

  // Antes de `wrangler dev` y `wrangler deploy` (también en Cloudflare) se arma .publicar/ (herramientas/construir.js).
  "build": {
    "command": "npm run construir",
    "watch_dir": ["public", "../../packages/diseno", "../../packages/comun/web"]
  },

  // Las páginas pasan por el Worker; los archivos fijos los sirve Cloudflare directamente (no gastan peticiones).
  // Las rutas llevan BASE_PATH delante: si cambias BASE_PATH, cámbialas también.
  "assets": {
    "directory": "./.publicar",
    "binding": "ASSETS",
    "run_worker_first": ["/planifica", "/planifica/*", "!/planifica/css/*", "!/planifica/js/*", "!/planifica/img/*", "!/planifica/vendor/*", "!/planifica/_ds/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Base de datos. Créala con:  npx wrangler d1 create planifica   y pega aquí el database_id.
  // (En local, con `wrangler dev`, sirve cualquier valor.)
  "d1_databases": [
    { "binding": "DB", "database_name": "planifica", "database_id": "PENDIENTE-pega-aqui-el-id" }
  ],

  // Variables públicas. El secreto SESSION_SECRET NO va aquí: `wrangler secret put SESSION_SECRET`.
  "vars": {
    // Si la app se muda a su propio dominio, pon "" y cambia "routes" y "run_worker_first".
    "BASE_PATH": "/planifica",
    "ENVIRONMENT": "production",
    "TZ_OFFSET_MIN": "-240"
  },

  // dualstudio.app/planifica y todo lo que cuelga de ahí. El resto de dualstudio.app lo atiende la central.
  "routes": [
    { "pattern": "dualstudio.app/planifica", "zone_name": "dualstudio.app" },
    { "pattern": "dualstudio.app/planifica/*", "zone_name": "dualstudio.app" }
  ],
  "workers_dev": false,
  "preview_urls": true,

  // Sitio de pruebas (Cloudflare «Previews»): cada cambio en una rama que no es master se publica aparte.
  "previews": {
    "vars": { "BASE_PATH": "/planifica", "ENVIRONMENT": "production", "TZ_OFFSET_MIN": "-240" },
    // Base de datos APARTE para las pruebas:  npx wrangler d1 create planifica-pruebas
    "d1_databases": [
      { "binding": "DB", "database_name": "planifica-pruebas", "database_id": "PENDIENTE-pega-aqui-el-id" }
    ]
  }
}
